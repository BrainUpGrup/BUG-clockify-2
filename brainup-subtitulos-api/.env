# Clave de la API de Anthropic (Claude) - https://console.anthropic.com
ANTHROPIC_API_KEY=

# Claves que el hub enviará en la cabecera X-API-Key (separadas por comas).
API_KEYS=hub_ucDd9f62jxylERMtAjDsKtC1hvD0kYOULe3D7YXpfdY

# Modelo y esfuerzo de Claude para revisión y traducción
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high

# Whisper: en servidor con GPU NVIDIA usa WHISPER_DEVICE=cuda y WHISPER_COMPUTE_TYPE=float16
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Carpeta donde se guardan vídeos y resultados
DATA_DIR=data
MAX_UPLOAD_MB=4096
