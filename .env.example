# Configuración de Supabase para BUG Clockify
# Obtén estas claves en tu panel de Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-aqui
# Muestra el bloque "Acceso rápido" con cuentas demo en /login fuera de desarrollo
# (en `npm run dev` siempre se muestra). Déjalo en false en producción.
NEXT_PUBLIC_SHOW_DEMO_LOGIN=false

