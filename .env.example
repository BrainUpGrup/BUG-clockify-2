# Solo servidor (rutas /api/slack/*). Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role-aqui

# Integración Slack (ver docs/INTEGRACION_SLACK.md)
# api.slack.com/apps -> tu app -> Basic Information / OAuth & Permissions
SLACK_CLIENT_ID=0000000000.0000000000
SLACK_CLIENT_SECRET=tu-client-secret-aqui
SLACK_SIGNING_SECRET=tu-signing-secret-aqui
# URL pública del Hub (en local, la del túnel ngrok/cloudflared)
SLACK_REDIRECT_BASE_URL=http://localhost:3000
# 32 bytes en base64 para cifrar el token del bot: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SLACK_TOKEN_ENCRYPTION_KEY=genera-una-clave-base64-de-32-bytes
# Secreto compartido para lanzar /api/slack/sync desde un cron
SLACK_SYNC_CRON_SECRET=tu-secreto-de-cron
